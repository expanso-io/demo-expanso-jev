# Add these to the repository-root .env alongside the existing Cloud credentials.
# Select explicitly; never use whichever Kubernetes context happens to be current.
KUBE_CONTEXT=jev-label-demo
POD_LABEL_NAMESPACES=jev-label-demo
# Generate a private random value of at least 32 characters. Share only between
# this adapter and this example's Edge agent, not with the Cloud control plane.
POD_LABEL_TOKEN=
# False by default. Set true to let verified Jev decisions patch pod labels.
POD_LABEL_APPLY=false
POD_LABEL_THRESHOLD=0.9
# TYPESAFE_API_KEY is read only by the adapter, never by the pipeline.
