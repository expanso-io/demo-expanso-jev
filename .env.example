# Copy to .env (just init). .env is gitignored; never commit it.

# --- Expanso Cloud ------------------------------------------------------------
# These are the CLIs' own variable names, so no secret ever reaches a command
# line. See AGENTS.md. Create a network at https://cloud.expanso.io, then copy
# its endpoint, an API key, and a node bootstrap token.
EXPANSO_CLI_ENDPOINT=
EXPANSO_CLI_AUTH_API_KEY=
EXPANSO_EDGE_BOOTSTRAP_TOKEN=

# --- Jev ----------------------------------------------------------------------
# With a TypeSafe key: run `just jev-key`. It prompts with hidden input and
# fills in both lines below.
# Without one: start the bundled mock (uv run shared/jev-mock-server.py) and use
#   JEV_API_URL=http://127.0.0.1:8099/v1/systemone
# The board labels mock answers in red; they are not real inference.
JEV_API_URL=
TYPESAFE_API_KEY=

# --- Optional -----------------------------------------------------------------
# JEV_GEN_RATE=30        baseline lines per second from the log generator
# JEV_GEN_JAGGED=1       0 for a flat, metronomic source
# JEV_LIVE_PORT=8890     dashboard port
